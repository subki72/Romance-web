# =============================================
# Sweet Memories Web App — Environment Template
# Copy to .env and fill with local values
# =============================================

PORT=3000
NODE_ENV=development

# Required authentication secret (non-empty)
APP_PASSWORD=change-me-example-passphrase

# Supabase PostgreSQL & Storage settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-placeholder
STORAGE_BUCKET=memories

# CORS & Security Controls (comma-separated origins; blank allows same-origin/dev)
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=50

# Rate Limiting, Caching & Upstream Timeout
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
REQUEST_TIMEOUT_MS=10000
DATA_CACHE_TTL_MS=5000
